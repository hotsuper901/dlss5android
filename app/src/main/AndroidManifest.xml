<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Special access, granted by the user in Settings. Without it Android
         5.1+ gives a normal app zero visibility into other running apps. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Package visibility for the supported titles, so detection and install
         checks work without QUERY_ALL_PACKAGES on API 30+. -->
    <queries>
        <!-- Verified against live Play Store listings 2026-09. Free Fire is
             com.dts.freefireth; com.garena.game.kgvn is Lien Quan Mobile. -->
        <package android:name="com.dts.freefireth" />
        <package android:name="com.dts.freefiremax" />
        <package android:name="com.garena.game.kgvn" />
        <package android:name="com.garena.game.kid" />
        <package android:name="com.tencent.ig" />
        <package android:name="com.tencent.ig.lite" />
        <package android:name="com.pubg.imobile" />
        <package android:name="com.pubg.newstate" />
        <package android:name="com.pubg.krmobile" />
        <package android:name="com.moonton.mobilelegends" />
        <package android:name="com.tencent.tmgp.sgame" />
        <package android:name="com.activision.callofduty.shooter" />
        <package android:name="ca.criticalops.thecriticalop" />

        <!-- Also query the launcher intent, because a hardcoded package list is
             a guess: repackaged and regional builds ship under names we cannot
             enumerate in advance. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".GfxApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MsjGfx">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MsjGfx">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.CoolerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="RAM and thermal maintenance while the user is gaming" />
        </service>

        <service
            android:name=".core.GameOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-screen frametime and memory HUD requested by the user" />
        </service>

        <receiver
            android:name=".core.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
